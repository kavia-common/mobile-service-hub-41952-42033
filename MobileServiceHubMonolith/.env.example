# Public web server port (must remain 3000 for preview)
PORT=3000

# Internal API port (Vite proxies /api to this port in development)
INTERNAL_API_PORT=8000
INTERNAL_API_URL=http://127.0.0.1:8000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/mobile_service_hub

# JWT secret for auth (replace in production)
JWT_SECRET=replace-me
